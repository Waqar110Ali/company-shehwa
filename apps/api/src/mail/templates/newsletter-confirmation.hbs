<!DOCTYPE html>
<html>
  <body style="margin:0; padding:0; background-color:#0f172a; font-family: Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding: 32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#111827; border-radius:16px; overflow:hidden;">
            <tr>
              <td style="padding: 32px;">
                <h2 style="color:#ffffff; margin:0 0 16px 0; font-size:22px;">
                  You're subscribed
                </h2>
                <p style="color:#94a3b8; font-size:15px; line-height:24px; margin:0 0 16px 0;">
                  Thanks for joining {{companyName}}. We'll send future product and technology updates to
                  <strong style="color:#22d3ee;">{{subscriberEmail}}</strong>.
                </p>
                <p style="color:#64748b; font-size:13px; line-height:20px; margin:0;">
                  No spam. You can unsubscribe anytime.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
