# API
VITE_API_URL=http://localhost:5000/api/v1

# Cal.com — username or username/event-slug (lowercase, no leading slash)
# Example: acme-team/intro-call
# Important: use lowercase (waqar-ali/30min). Mixed case breaks booking.
VITE_CALCOM_LINK=

# Optional: self-hosted Cal.com origin (default https://cal.com)
# VITE_CALCOM_ORIGIN=https://cal.com
